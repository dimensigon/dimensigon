FROM python:3.11-slim

LABEL maintainer="JOAN PRAT joan.prat@knowtrade.eu"
LABEL description="Dimensigon 2.0 - Distributed Orchestration Platform with DM-WebManager GUI"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY dimensigon/ ./dimensigon/
COPY templates/ ./templates/
COPY setup.py .
COPY README.md .

# Install Dimensigon
RUN pip install --no-cache-dir -e .

# Create non-root user
RUN useradd -m -u 1000 dimensigon && \
    chown -R dimensigon:dimensigon /app

USER dimensigon

# Expose ports
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:5000/', timeout=5)" || exit 1

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV FLASK_APP=dimensigon.web

# Start Dimensigon web server
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--timeout", "120", "dimensigon.web:create_app('production')"]
