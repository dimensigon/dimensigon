# Dimensigon 2.0 Environment Configuration Template
# Copy this file to .env and customize for your environment
# Usage: cp .env.example .env

# ============================================================================
# CRITICAL SECURITY SETTINGS
# ============================================================================

# REQUIRED: Secret key for JWT tokens and session encryption (PRODUCTION ONLY)
# CRITICAL: This MUST be set to a strong random value in production.
# The application will FAIL TO START if this is not configured properly.
#
# Generate a secure secret with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# NEVER use the placeholder value or any hardcoded string.
# Each environment should have a UNIQUE secret key.
#
# In production, set this via:
#   - Environment variable: DM_SECRET_KEY=<generated_value>
#   - Docker secret: echo "<generated_value>" | docker secret create dm_secret -
#   - Kubernetes secret: kubectl create secret generic dm-secret --from-literal=key=<value>
#
DM_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE_OR_APPLICATION_WILL_FAIL_TO_START

# REQUIRED: PostgreSQL database password
POSTGRES_PASSWORD=change-this-secure-database-password

# Redis password (for caching and session storage)
REDIS_PASSWORD=change-this-redis-password

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Flask configuration mode (production, development, test)
FLASK_CONFIG=production

# Flask application module
FLASK_APP=dimensigon.web

# Python optimization settings
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database Settings
POSTGRES_DB=dimensigon
POSTGRES_USER=dimensigon

# Full database URI (alternative to individual settings)
# Format: postgresql://user:password@host:port/database
# For Docker: postgresql://dimensigon:password@postgres:5432/dimensigon
# For local: postgresql://dimensigon:password@localhost:5432/dimensigon
SQLALCHEMY_DATABASE_URI=postgresql://dimensigon:${POSTGRES_PASSWORD}@postgres:5432/dimensigon

# SQLAlchemy settings
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis connection URL (for future caching features)
# Format: redis://[:password]@host:port/db
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Dimensigon listen port (default: 20194)
DM_PORT=20194

# HTTP host binding (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HTTP_HOST=0.0.0.0

# External port mapping (for docker-compose port publishing)
DIMENSIGON_PORT=20194

# Preferred URL scheme for inter-node communication
PREFERRED_URL_SCHEME=https

# ============================================================================
# GUNICORN WEB SERVER CONFIGURATION
# ============================================================================

# Number of worker processes
# Recommendation: (2 x CPU cores) + 1
WORKERS=4

# Worker timeout in seconds
GUNICORN_TIMEOUT=120

# Keep-alive timeout
GUNICORN_KEEPALIVE=5

# Python version for multi-stage build
PYTHON_VERSION=3.11

# ============================================================================
# SSL/TLS CONFIGURATION
# ============================================================================

# SSL certificate paths (relative to project root)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# SSL verification for outgoing requests
SSL_VERIFY=False

# Enable SSL redirect (redirect HTTP to HTTPS)
SSL_REDIRECT=False

# ============================================================================
# NGINX REVERSE PROXY CONFIGURATION
# ============================================================================

# Nginx HTTP port
NGINX_HTTP_PORT=80

# Nginx HTTPS port
NGINX_HTTPS_PORT=443

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Access log file (use '-' for stdout)
ACCESS_LOGFILE=-

# Error log file (use '-' for stderr)
ERROR_LOGFILE=-

# ============================================================================
# APPLICATION FEATURES
# ============================================================================

# Executor thread pool size (for background tasks)
EXECUTOR_MAX_WORKERS=32

# Auto-upgrade enabled
AUTOUPGRADE=True

# Enable securizer (encryption layer)
SECURIZER=True

# Enable plain securizer
SECURIZER_PLAIN=True

# Enable scheduler
SCHEDULER=True

# ============================================================================
# DATA PERSISTENCE
# ============================================================================

# Base directory for data volumes (used in docker-compose)
DATA_DIR=./data

# ============================================================================
# DIMENSIGON INITIALIZATION (DOCKER ONLY)
# ============================================================================

# Set to 'true' to create a new dimension on first startup
DIMENSIGON_INIT_NEW=false

# Dimension name (required if DIMENSIGON_INIT_NEW=true)
DIMENSION_NAME=production-cluster

# Set to 'true' to join an existing dimension on startup
DIMENSIGON_JOIN=false

# Join server address (required if DIMENSIGON_JOIN=true)
JOIN_SERVER=

# Join authentication token (required if DIMENSIGON_JOIN=true)
JOIN_TOKEN=

# Join server port (default: 20194)
JOIN_PORT=20194

# Use SSL for join (true/false)
JOIN_SSL=true

# Verify SSL certificate during join (true/false)
JOIN_VERIFY=false

# ============================================================================
# ADVANCED DIMENSIGON SETTINGS
# ============================================================================

# Maximum time waiting for servers to be created (seconds)
MAX_TIME_WAITING_SERVERS=1800

# Join token expiration time (minutes)
JOIN_TOKEN_EXPIRE_TIME=15

# Route refresh period (seconds)
ROUTE_REFRESH_PERIOD=300

# Route send period (seconds)
ROUTE_SEND_PERIOD=10

# Catalog refresh period (seconds)
CATALOG_REFRESH_PERIOD=300

# Cluster send period (seconds)
CLUSTER_SEND_PERIOD=10

# File synchronization period (seconds)
FILE_SYNC_PERIOD=5

# Request timeout (seconds)
TIMEOUT_REQUEST=60

# Command execution timeout (seconds)
TIMEOUT_COMMAND=20

# Remote command execution timeout (seconds)
TIMEOUT_REMOTE_COMMAND=7200

# Lock request timeout (seconds)
TIMEOUT_LOCK_REQUEST=60

# ============================================================================
# MONITORING AND HEALTH CHECKS
# ============================================================================

# Health check endpoint
HEALTH_CHECK_PATH=/health

# Metrics endpoint (for Prometheus, etc.)
METRICS_ENABLED=false
METRICS_PATH=/metrics

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup directory
BACKUP_DIR=/backup/dimensigon

# Backup retention days
BACKUP_RETENTION_DAYS=30

# ============================================================================
# DEVELOPMENT SETTINGS (DO NOT USE IN PRODUCTION)
# ============================================================================

# Flask debug mode (NEVER enable in production!)
# FLASK_DEBUG=0

# Development database URL (SQLite for testing)
# DM_DEV_DATABASE_URL=sqlite:///dimensigon-dev.db

# ============================================================================
# NOTES
# ============================================================================

# 1. SECURITY: Always use strong, randomly generated passwords
# 2. DATABASE: PostgreSQL is recommended for production (not SQLite)
# 3. SSL: Use valid CA-signed certificates in production
# 4. WORKERS: Adjust based on your CPU cores and workload
# 5. PORTS: Ensure ports are not blocked by firewall
# 6. BACKUPS: Configure automated database backups
# 7. MONITORING: Set up logging aggregation and metrics collection
# 8. UPDATES: Keep Dimensigon and dependencies up to date

# For more information, see: DEPLOYMENT_GUIDE.md
